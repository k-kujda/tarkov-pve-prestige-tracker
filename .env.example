# Copy to .env and set your game folder: the one with EscapeFromTarkov.exe and EscapeFromTarkov_Data
TARKOV_DIR=C:\Battlestate Games\Escape from Tarkov

# Only if the game's logs aren't in <TARKOV_DIR>\Logs: their folder inside TARKOV_DIR (some Steam installs use build/Logs)
# TARKOV_LOGS_DIR=build/Logs

# PORT=4747
# Parallel maps for the navmesh build; each takes several GB of RAM, lower it if Docker runs out of memory
# JOBS=4
